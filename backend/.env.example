# Sentinel Vision AI backend configuration (copy values into your shell environment).
# Nothing loads this file automatically yet.

# CLIP scene-domain model (Hugging Face)
SENTINEL_CLIP_MODEL_ID=openai/clip-vit-base-patch32
SENTINEL_CLIP_MODEL_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268

# Langflow evaluation (external LLM review of parking candidates)
# Must be a complete run URL: http(s)://<host>/api/v1/run/<flow_id>
SENTINEL_LANGFLOW_URL=
SENTINEL_LANGFLOW_API_KEY=
SENTINEL_LANGFLOW_TIMEOUT_SECONDS=30
SENTINEL_LANGFLOW_COMPONENT_ID=Webhook-exTZU
SENTINEL_LANGFLOW_MODEL=gemini-3-flash-preview
