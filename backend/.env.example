# Sentinel Vision AI backend configuration (copy values into your shell environment).
# Nothing loads this file automatically yet.

# CLIP scene-domain model (Hugging Face)
SENTINEL_CLIP_MODEL_ID=openai/clip-vit-base-patch32
SENTINEL_CLIP_MODEL_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268

# Langflow evaluation (external LLM review of parking candidates)
# Must be a complete Webhook URL: http(s)://<host>/api/v1/webhook/<flow_id>
SENTINEL_LANGFLOW_URL=
SENTINEL_LANGFLOW_API_KEY=
# ACK transport timeout only; must be >0 and <=10 seconds. Gemini returns by callback.
SENTINEL_LANGFLOW_TIMEOUT_SECONDS=5
SENTINEL_LANGFLOW_MODEL=gemini-3-flash-preview

# Separate shared token for the inbound evaluation callback endpoint.
SENTINEL_CALLBACK_TOKEN=
# Maximum wait for Gemini callback after dispatch; must be >0 and <=60 seconds.
# The process-wide pending budget timeout is this value plus 15 seconds.
SENTINEL_EVALUATION_CALLBACK_TIMEOUT_SECONDS=45
# Optional cap on external dispatch attempts for the lifetime of this backend
# process (decimal integer 1-1000). Leave it unset for no cap. Any other value,
# including an empty one, disables external evaluation. An attempt is spent at
# handoff, before the request, even if the ACK fails or no HTTP request is sent;
# callback, timeout, Stop and new sessions never return it. The counter resets
# when the process restarts: during a capped test run use exactly one worker
# (--workers 1), no --reload, and never restart to try again.
# SENTINEL_EVALUATION_MAX_DISPATCHES=1

# Optional local audio alert (Windows only, default output device). Plays one
# local PCM WAV (max 8 s) for a validated CRITICAL assessment that was ACCEPTED
# for the active session. NORMAL/WARNING, timeouts, failures and local
# candidates never play. At most one attempt per event, no retry; candidates
# arriving during the cooldown are dropped. Stop/EOF/new session drop the queued
# alert and signal the in-flight clip to stop; a short audible tail is still
# possible. If the device stop fails, audio stays disabled until restart.
# Exactly-once per event relies on ACCEPTED being published once. The WAV must live outside the
# repository and is not committed; keep its wording activity-based (no identity,
# ownership or police claims). Only true/false are accepted for the flag; any
# invalid audio setting disables audio only, never evaluation or video.
SENTINEL_AUDIO_ALERT_ENABLED=false
# SENTINEL_AUDIO_ALERT_FILE=C:\path\outside\repo\alert.wav
# Seconds between playback attempts (10-120, default 30).
# SENTINEL_AUDIO_ALERT_COOLDOWN_SECONDS=30

# Optional metadata-only upload-to-preview milestone logs; accepts only true/false.
# Browser upload duration is excluded; measure it in DevTools Network.
SENTINEL_VIDEO_STARTUP_TIMING_ENABLED=false
